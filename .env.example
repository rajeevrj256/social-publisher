# ---------- Database ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=social_publisher
POSTGRES_USER=publisher
# Left blank on purpose: start.sh / start.ps1 generates a strong
# one on first run. Setting a weak value here would be kept as-is.
POSTGRES_PASSWORD=
# Set DATABASE_URL to use a managed Postgres (Neon, Supabase, RDS...). When it
# is set the local postgres container is not started at all, and the POSTGRES_*
# values above are ignored.
#
# Neon: take the connection string from the console and convert it -
#   jdbc:postgresql://HOST/DB?user=U&password=P&sslmode=require
# becomes
#   postgresql+psycopg://U:P@HOST/DB?sslmode=require&channel_binding=require
#
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Encryption ----------
# 32-byte urlsafe base64 Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Only this chat id may issue commands. Everything else is ignored.
TELEGRAM_CHAT_ID=

# ---------- Media ----------
# Root for all `local` sources. A source's `location` is a folder under this,
# e.g. location "channel_one" -> /videos/to_publish/channel_one
VIDEO_ROOT=/videos/to_publish

# FALLBACK ONLY - not the per-account link.
# Instagram fetches the file itself, so it needs a public https URL:
#   - source kind `remote_url`: its own location is used. This is ignored.
#   - source kind `local`:      the file must still be served somewhere, and
#                               that base URL goes here.
# Per-account links are configured in the database, not here - see MAPPING_API.md.
# Resolves to {PUBLIC_MEDIA_BASE_URL}/{video.filepath}
PUBLIC_MEDIA_BASE_URL=

# ---------- Meta / Instagram ----------
# https://developers.facebook.com/apps -> your app
# Also a fallback: accounts under different Meta apps can carry their own
# app id/secret via set-oauth-client / the API, same as YouTube.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# graph.instagram.com  -> "Instagram API with Instagram Login" (no FB Page)
# graph.facebook.com   -> "Instagram API with Facebook Login" (Page-linked)
INSTAGRAM_GRAPH_HOST=graph.instagram.com
# Instagram allows 100 API publishes per rolling 24h per account
INSTAGRAM_DAILY_LIMIT=100

# ---------- YouTube ----------
# Google Cloud console OAuth client (Desktop app type)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
# videos.insert is capped at 100 uploads/day per project
YOUTUBE_DAILY_LIMIT=100

# ---------- AI metadata (optional) ----------
# Leave blank to write every caption yourself. With no key the bot asks you for
# the title/caption/hashtags on Telegram before anything is published - it never
# invents them or falls back to the filename.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---------- Behaviour ----------
MAX_RETRIES=3
SCHEDULER_TICK_SECONDS=60
STUCK_JOB_MINUTES=30
LOG_LEVEL=INFO
TZ=Asia/Kolkata

# Rejected proposals tolerated per slot before it is abandoned
REJECTION_LIMIT=5

# ---------- Admin mapping API ----------
# Bearer token for POSTing mappings. Generate: openssl rand -hex 32
ADMIN_API_TOKEN=
# Keep on localhost unless you deliberately want it reachable.
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8088
